{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.UsamaTahreemKhalid/journeyproof",
  "title": "JourneyProof",
  "description": "Explicit local browser journeys, evidence maps and regression generation.",
  "version": "0.1.0-rc.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "journeyproof",
      "version": "0.1.0-rc.1",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }],
      "environmentVariables": [
        {
          "name": "JOURNEYPROOF_WORKSPACE_ROOT",
          "description": "Explicit approved local application directory",
          "format": "filepath",
          "isRequired": true
        },
        {
          "name": "JOURNEYPROOF_FLOW_ROOT",
          "description": "Approved workspace-relative flow directory",
          "isRequired": true
        }
      ]
    }
  ]
}

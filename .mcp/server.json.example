{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.UsamaTahreemKhalid/journeyproof",
  "title": "JourneyProof",
  "description": "Explicit local browser journeys, evidence maps and regression generation.",
  "version": "0.1.0-rc.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "journeyproof",
      "version": "0.1.0-rc.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "JOURNEYPROOF_WORKSPACE_ROOT",
          "description": "Workspace directory; defaults to the server working directory",
          "format": "filepath",
          "isRequired": false
        },
        {
          "name": "JOURNEYPROOF_FLOW_ROOT",
          "description": "Workspace-relative approved flow directory; defaults to examples/admissions-demo/journeys",
          "isRequired": false
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/UsamaTahreemKhalid/journeyproof",
    "source": "github"
  }
}
